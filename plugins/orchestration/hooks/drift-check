#!/usr/bin/env bash
# Advisory "orchestrator drift" Stop hook.
#
# Asks a separate model whether the orchestrator has drifted from its own wave
# plan, and surfaces the answer as additionalContext for the Stop event.
#
# Advisory only: it never blocks and never exits non-zero. Every failure path —
# missing files, a finished wave, a model call that fails, times out, returns
# empty, or answers off-contract — ends in "{}".
#
# Set CLAUDE_DRIFT_CHECK_DRYRUN=1 to print the gating decision instead of
# calling the model. The gates are then testable in milliseconds, offline.

set -u

DRYRUN="${CLAUDE_DRIFT_CHECK_DRYRUN:-}"

# Silence, with the reason. The reason is only printed in dry-run: the harness
# wants JSON, a human debugging the gates wants the reason.
silent() {
  if [ -n "$DRYRUN" ]; then
    printf 'silent: %s\n' "$1"
  else
    printf '{}\n'
  fi
  exit 0
}

# --- gate 1: re-entrancy -----------------------------------------------------
# This hook shells out to `claude -p`; that nested session loads the same enabled
# plugins and would fire this very hook again, which would call `claude -p`
# again. The nested run sees the marker and leaves immediately.
if [ -n "${CLAUDE_DRIFT_CHECK_ACTIVE:-}" ]; then
  silent "reentrant"
fi

# Always consume stdin so the caller never blocks on a full pipe.
payload="$(cat 2>/dev/null || true)"

repo_root="$(git rev-parse --show-toplevel 2>/dev/null)"
if [ -z "$repo_root" ]; then
  repo_root="$(pwd)"
fi

# --- gate 2: a wave plan must exist ------------------------------------------
plan_file="$(ls -t "$repo_root"/docs/superpowers/plans/*-wave-*.md 2>/dev/null | head -n1)"
if [ -z "$plan_file" ] || [ ! -f "$plan_file" ]; then
  silent "no-plan"
fi

# --- gate 3: the plan must declare itself active ------------------------------
# The plan is a permanent artifact; its status is what says whether the wave is
# running. Deleting the plan to stop the hook would burn the record the whole
# design depends on, so the lifecycle lives in a field instead.
plan_status="$(sed -n 's/^[[:space:]]*status:[[:space:]]*\([a-zA-Z-]*\).*/\1/p' "$plan_file" | head -n1)"
if [ "$plan_status" = "done" ]; then
  silent "wave-done"
fi

# --- gate 4: self-clearing safety net ----------------------------------------
# If the plan names branches and none of them still exist, the wave is over
# whatever the status field says. Branches disappear when work is merged, so
# this signal comes from the work itself rather than from anyone remembering to
# flip a field. Forgetting therefore degrades to silence, not to a permanent
# per-turn cost.
planned_branches="$(grep -oE 'wave/[A-Za-z0-9._-]+' "$plan_file" 2>/dev/null | sort -u)"
if [ -n "$planned_branches" ]; then
  live=0
  for b in $planned_branches; do
    if git -C "$repo_root" show-ref --verify --quiet "refs/heads/$b"; then
      live=1
      break
    fi
  done
  if [ "$live" -eq 0 ]; then
    silent "no-live-branches"
  fi
fi

# --- resolve the prompt -------------------------------------------------------
if [ -n "${CLAUDE_PLUGIN_ROOT:-}" ]; then
  plugin_root="$CLAUDE_PLUGIN_ROOT"
else
  plugin_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd 2>/dev/null)"
fi

prompt_file="$plugin_root/skills/multi-model/references/orchestrator-drift-prompt.md"
if [ -z "$plugin_root" ] || [ ! -f "$prompt_file" ]; then
  silent "no-prompt"
fi

# --- gate 5: cost pre-filter (a heuristic, and labelled as one) ---------------
# Reading the transcript costs nothing; asking the model costs ~8s. Only ask when
# the turn actually claimed something worth checking. This filters COST, not
# correctness: a missed check in an advisory mechanism is a missed suggestion,
# which is why a keyword gate is an acceptable trade here and would not be if the
# hook could block.
transcript_path="$(printf '%s' "$payload" | python3 -c '
import json, sys
try:
    print(json.load(sys.stdin).get("transcript_path", "") or "")
except Exception:
    print("")
' 2>/dev/null || true)"

transcript_tail=""
if [ -n "$transcript_path" ] && [ -f "$transcript_path" ]; then
  transcript_tail="$(tail -n 200 "$transcript_path" 2>/dev/null || true)"
fi

if [ -z "$transcript_tail" ]; then
  silent "no-transcript"
fi

if ! printf '%s' "$transcript_tail" | grep -qiE 'done|complete|finished|verified|merged|passed|landed|shipped|task .*(result|report)'; then
  silent "nothing-claimed"
fi

if [ -n "$DRYRUN" ]; then
  printf 'would-call\n'
  exit 0
fi

# --- the model call -----------------------------------------------------------
prompt_text="$(cat "$prompt_file" 2>/dev/null || true)"
plan_text="$(cat "$plan_file" 2>/dev/null || true)"

full_prompt="$(printf '%s\n\n---\nWave plan (%s):\n%s\n\n---\nRecent transcript tail:\n%s\n' \
  "$prompt_text" "$plan_file" "$plan_text" "$transcript_tail")"

tmp_out="$(mktemp 2>/dev/null || echo "/tmp/drift-check.$$")"
CLAUDE_DRIFT_CHECK_ACTIVE=1 claude -p "$full_prompt" --model claude-haiku-4-5-20251001 \
  </dev/null >"$tmp_out" 2>/dev/null &
claude_pid=$!

# The watchdog must not inherit our stdout: a caller using $(...) waits for every
# process holding that pipe, and killing this subshell does not reap its own
# `sleep` child. An orphaned sleep would hold the pipe for its full duration and
# make the hook appear to take exactly the watchdog interval on every turn.
(
  sleep 45
  kill -TERM "$claude_pid" 2>/dev/null
) >/dev/null 2>&1 &
watchdog_pid=$!

wait "$claude_pid" 2>/dev/null
claude_status=$?

kill "$watchdog_pid" 2>/dev/null
wait "$watchdog_pid" 2>/dev/null

answer="$(cat "$tmp_out" 2>/dev/null || true)"
rm -f "$tmp_out" 2>/dev/null

if [ "$claude_status" -ne 0 ] || [ -z "$answer" ]; then
  silent "model-failed"
fi

# The prompt allows exactly two shapes: bullet points, or the word NOTHING.
trimmed="$(printf '%s' "$answer" | tr -d '[:space:]')"
if [ "$trimmed" = "NOTHING" ]; then
  silent "nothing-to-say"
fi

first_char="$(printf '%s' "$answer" | sed -e 's/^[[:space:]]*//' | cut -c1)"
if [ "$first_char" != "-" ]; then
  silent "off-contract-answer"
fi

escaped="$(printf '%s' "$answer" | python3 -c 'import json,sys;print(json.dumps(sys.stdin.read()))' 2>/dev/null || true)"
if [ -z "$escaped" ]; then
  silent "escape-failed"
fi

printf '{"hookSpecificOutput":{"hookEventName":"Stop","additionalContext":%s}}\n' "$escaped"
exit 0
